LLM_PROVIDER=mock            # mock = offline demo. Use "anthropic" with ANTHROPIC_API_KEY for a real AI.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
DEMO_DELAY=1.0               # seconds between steps so judges can watch the log fill up
DEMO_AD_FAILURES=2           # scripted ad-platform failures: retry, then reassign to Finance
FRONTEND_ORIGIN=http://localhost:3000
